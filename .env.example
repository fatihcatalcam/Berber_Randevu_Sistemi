# Meta WhatsApp Business API ayarları
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# Meta System User Access Token (kalıcı token)
WHATSAPP_TOKEN=

# Meta WhatsApp Phone Number ID
PHONE_NUMBER_ID=

# Webhook doğrulama token'ı (Meta panelinde aynısını gireceksiniz)
VERIFY_TOKEN=berber_token_123

# Sunucu portu
PORT=3000
