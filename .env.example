# Meta WhatsApp Business API ayarları
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.

# PostgreSQL bağlantı dizesi (Neon, Supabase vb.)
# Örnek: postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Meta System User Access Token (kalıcı token)
WHATSAPP_TOKEN=

# Meta WhatsApp Phone Number ID
PHONE_NUMBER_ID=

# Webhook doğrulama token'ı (Meta panelinde aynısını gireceksiniz)
VERIFY_TOKEN=berber_token_123

# Meta App Secret — webhook imza doğrulaması için (Meta > App > Settings > Basic)
# Boş bırakılırsa imza kontrolü devre dışı kalır (sadece yerel geliştirmede önerilir).
APP_SECRET=

# Meta'da onaylanmış hatırlatma şablonunun adı (ör. randevu_hatirlatma).
# Müşterinin son mesajından 24 saat geçtiyse Meta serbest metne izin vermez;
# hatırlatma bu şablonla gönderilir. Şablon gövdesi 4 parametre almalı:
# {{1}} berber, {{2}} hizmet, {{3}} tarih, {{4}} saat.
# Boşsa yalnızca 24 saat penceresi açık müşterilere hatırlatma gider.
TEMPLATE_HATIRLATMA=

# Sunucu portu
PORT=3000

# ---------------------------------------------------------------------------
# Google Sheets canlı senkron (opsiyonel - boşsa senkron devre dışı kalır)
# ---------------------------------------------------------------------------
# Service account e-postası (...@....iam.gserviceaccount.com)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Service account özel anahtarı. JSON'daki private_key değeri.
# Railway'de tek satır olarak, satır sonları \n ile yapıştırılır.
GOOGLE_PRIVATE_KEY=
# Aktif tablo ID'si (URL'deki /d/ ... /edit arası)
GOOGLE_SHEET_ID=
# Arşiv tablo ID'si
GOOGLE_ARCHIVE_SHEET_ID=
# Müşteri veritabanı tablo ID'si (ayrı dosya: isim, telefon, berber kaydı)
# Servis hesabı e-postasıyla paylaşmayı unutmayın. Boşsa müşteri kaydı devre dışı.
GOOGLE_MUSTERI_SHEET_ID=

# Not: Yerel geliştirmede yukarıdaki yerine proje köküne google-key.json
# (service account JSON dosyası) koyabilirsin; kod onu otomatik kullanır.
